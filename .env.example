# Cole no ambiente dos dois serviços App no EasyPanel (web e worker).
DEBUG=0
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_50_CARACTERES
DATABASE_URL=postgresql://USUARIO:SENHA_URL_ENCODED@HOST_INTERNO:5432/BANCO
ALLOWED_HOSTS=track.metricz.com.br,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://track.metricz.com.br
